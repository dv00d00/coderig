<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rig</ToolCommandName>
    <PackageId>rig</PackageId>
    <Version>0.1.1</Version>
    <Description>CLI tool that indexes .NET solutions and exposes per-entry-point call graphs annotated with external effects.</Description>
    <Authors>dv00d00</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dv00d00/coderig</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dv00d00/coderig</PackageProjectUrl>

    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rig.Tests" />
    <InternalsVisibleTo Include="Rig.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rig.Analysis\Rig.Analysis.csproj" />
    <ProjectReference Include="..\Rig.Storage\Rig.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same as wwwroot below: the publish output carries it into the tool package, so the explicit
         Pack/PackagePath only added a duplicate and an NU5118 warning. -->
    <None Include="builtin-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- `PackAsTool` packs the PUBLISH OUTPUT, so `CopyToOutputDirectory` is what puts wwwroot in the package;
         the explicit `Pack`/`PackagePath` that used to be here added every file a SECOND time and produced ten
         NU5118 "already contains file" warnings on every pack. Two consequences worth knowing before adding a
         file here: it ships in the installed tool, and `Pack="false"` cannot stop it — so no fixtures. -->
    <None Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
