      Namespace="Rig.Tests.Cli"
      TestClass="ImpactRefReachStorageTests"
    />

    <!-- Manual lane: development audits, architecture spikes, scale generators, and env-gated measurement
         harnesses. They remain runnable on demand but are not release regressions and must not create a
         fresh process in every local/CI gate. -->
    <ManualIntegrationSource
      Include="$(MSBuildThisFileDirectory)..\Rig.Tests\Analysis\CoreAllocationIlAuditTests.cs"
      Link="Analysis\CoreAllocationIlAuditTests.cs"
      Namespace="Rig.Tests.Analysis"
      TestClass="CoreAllocationIlAuditTests"
    />

    <!-- Independent lane: each correctness-regression class is invoked in a fresh test process. -->
