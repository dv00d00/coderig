      Include="$(MSBuildThisFileDirectory)..\Rig.Tests\Cli\WatchCommandTests.cs"
      Link="Cli\WatchCommandTests.cs"
      Namespace="Rig.Tests.Cli"
      TestClass="WatchCommandTests"
    />
