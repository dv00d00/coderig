    />
    <LiveIntegrationSource
      Include="$(MSBuildThisFileDirectory)Analysis\ResidentIndexTests.cs"
      Link="Analysis\ResidentIndexTests.cs"
      Namespace="Rig.IntegrationTests.Analysis"
      TestClass="ResidentIndexTests"
    />
  </ItemGroup>

  <!-- The item type is the explicit lane choice. The ordinary suite owns most physical sources, while
       the shared integration project owns ResidentIndexTests physically. Exclude every classified source
       from those default globs so each test is discovered by exactly one executable. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Rig.Tests'">
    <Compile Remove="@(SharedIntegrationSource->'%(Link)')" />
    <Compile Remove="@(IndependentIntegrationSource->'%(Link)')" />
    <Compile Remove="@(LiveIntegrationSource->'%(Link)')" />
    <Compile Remove="@(ManualIntegrationSource->'%(Link)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Rig.IntegrationTests'">
    <Compile Remove="Analysis\ResidentIndexTests.cs" />
  </ItemGroup>
</Project>
