<Project>
  <ItemGroup>
    <!-- Shared fixture lane: keep every PerTestSession AnalyzedPlaygrounds consumer in one process. -->
    <SharedIntegrationSource
      Include="$(MSBuildThisFileDirectory)..\Rig.Tests\Analysis\FactDerivationTests.cs"
      Link="Analysis\FactDerivationTests.cs"
      Namespace="Rig.Tests.Analysis"
      TestClass="FactDerivationTests"
    />
