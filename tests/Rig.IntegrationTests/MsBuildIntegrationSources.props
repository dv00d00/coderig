      Link="Fixtures\TempPlayground.cs"
    />
    <MsBuildIntegrationSupport
      Include="$(MSBuildThisFileDirectory)..\Rig.Tests\Fixtures\DeepChainPlayground.cs"
      Link="Fixtures\DeepChainPlayground.cs"
    />
    <MsBuildIntegrationSupport
      Include="$(MSBuildThisFileDirectory)..\Rig.Tests\Fixtures\LiveScalePlayground.cs"
