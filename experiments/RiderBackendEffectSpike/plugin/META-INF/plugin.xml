<idea-plugin require-restart="true">
  <id>dev.coderig.rider</id>
  <name>CodeRig</name>
  <version>0.4.0</version>
  <vendor>CodeRig</vendor>
  <idea-version since-build="262" until-build="262.*" />
  <depends>com.intellij.modules.rider</depends>

  <description>
    <![CDATA[
    Shows SQL and file-system effects as method Code Vision summaries plus gutter-marked call sites and inline hints.
    Uses the resident CodeRig host and never opens the index database inside Rider.
  ]]>
  </description>

  <extensions defaultExtensionNs="com.intellij">
    <projectService serviceImplementation="dev.coderig.rider.frontend.CodeRigStatusService" />
    <statusBarWidgetFactory
      id="CodeRigStatus"
      implementation="dev.coderig.rider.frontend.CodeRigStatusWidgetFactory"
      order="after Position"
    />
  </extensions>

  <actions>
    <action
      id="CodeRig.RefreshStatus"
      class="dev.coderig.rider.frontend.RefreshStatusAction"
      text="CodeRig: Refresh Status"
      description="Refresh the resident CodeRig watch status"
    />
    <action
      id="CodeRig.RestartWatch"
      class="dev.coderig.rider.frontend.RestartWatchAction"
      text="CodeRig: Restart Watch"
      description="Gracefully restart the resident CodeRig watch host"
    />
    <group id="CodeRig.Tools" text="CodeRig" popup="true">
      <reference ref="CodeRig.RefreshStatus" />
      <reference ref="CodeRig.RestartWatch" />
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </group>
  </actions>
</idea-plugin>
