<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CodeRig.Rider</AssemblyName>
    <RootNamespace>CodeRig.Rider</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>CodeRig</Authors>
    <Description>Projects resident CodeRig effect reachability into Rider Code Vision and semantic call-site highlighting.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <OutputPath>bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);fixture\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Rider.SDK" Version="2026.2.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Runtime.Serialization">
      <Aliases>runtimeSerialization</Aliases>
    </Reference>
  </ItemGroup>
</Project>
